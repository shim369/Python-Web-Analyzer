{
  "name": "Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/astral-sh/uv:latest": {}
  },

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/web_analyzer/main.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "postCreateCommand": "uv sync",

  "postAttachCommand": {
    "server": "uv run streamlit run src/web_analyzer/main.py --server.enableCORS false --server.enableXsrfProtection false"
  },

  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },

  "forwardPorts": [
    8501
  ]
}
