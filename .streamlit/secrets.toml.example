# .streamlit/secrets.toml の雛形。コピーして secrets.toml にリネームし、APIキーを記載する。
# （secrets.toml は .gitignore 済み。このファイルには実際のキーを書かないこと）

# 用途・構成のAI補完で使用する Gemini APIキー（必須）
GEMINI_API_KEY = "your-api-key"

# 以下は任意（Streamlitはトップレベルのキーを環境変数にも反映する）
# GEMINI_MODEL = "gemini-3.5-flash-lite"   # 使用モデル
# GEMINI_MIN_INTERVAL_SEC = "6"             # リクエスト間隔の秒数（既定6秒＝最大10RPM）
